# Server
NODE_ENV=development
PORT=4000

# Frontend (CORS). Vergul bilan bir nechta manba kiritishingiz mumkin.
CORS_ORIGINS=http://localhost:5173

# Ma'lumotlar bazasi (PostgreSQL)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=algoritm_amaliyot
DB_USER=postgres
DB_PASSWORD=postgres

# JWT
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=12h

# Taklif havolalari (invite tokens)
INVITE_EXPIRES_HOURS=72

# Frontend manzili (taklif havolasini yig'ish uchun)
APP_BASE_URL=http://localhost:5173

# Vaqt zonasi
TZ=Asia/Tashkent
