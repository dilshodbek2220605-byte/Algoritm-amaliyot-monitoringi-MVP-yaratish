{
  "name": "algoritm-amaliyot-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Algoritm amaliyot monitoringi - backend (Express 5 + Sequelize + PostgreSQL)",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "ensure:env": "node scripts/ensureEnv.js",
    "dev": "node scripts/ensureEnv.js && node --watch src/server.js",
    "start": "node scripts/ensureEnv.js && node src/server.js",
    "db:create": "node scripts/ensureEnv.js && sequelize-cli db:create",
    "db:drop": "node scripts/ensureEnv.js && sequelize-cli db:drop",
    "db:migrate": "node scripts/ensureEnv.js && sequelize-cli db:migrate",
    "db:migrate:undo": "node scripts/ensureEnv.js && sequelize-cli db:migrate:undo:all",
    "db:seed": "node scripts/ensureEnv.js && sequelize-cli db:seed:all",
    "db:reset": "node scripts/ensureEnv.js && sequelize-cli db:drop && sequelize-cli db:create && sequelize-cli db:migrate && sequelize-cli db:seed:all",
    "seed:demo": "node scripts/ensureEnv.js && node src/scripts/seedDemo.js",
    "test:api": "node scripts/smokeTest.mjs"
  },
  "dependencies": {
    "algoritm-amaliyot-monitoringi": "file:..",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "node-cron": "^3.0.3",
    "pg": "^8.13.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.5"
  },
  "devDependencies": {
    "sequelize-cli": "^6.6.2"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
